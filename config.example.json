{
  "port": 3000,
  "dataDir": "./data",
  "transcriptionModel": "whisper-large-v3",
  "groq": { "apiKey": "" },
  "jev": { "apiKey": "", "model": "jev-1.14.0" },
  "haiku": { "apiKey": "", "model": "claude-haiku-5-5" },
  "embeddings": { "provider": "local", "model": "Xenova/bge-m3" },
  "notion": { "clientId": "", "clientSecret": "" },
  "thresholds": {
    "whisperAvgLogprob": -1.0,
    "whisperNoSpeechProb": 0.6,
    "whisperCompressionRatio": 2.4,
    "noiseMinProbability": 0.95
  },
  "contextMarginMs": 60000,
  "contentAlignment": {
    "spanMs": 30000,
    "audioWindowMs": 240000,
    "shortItemChars": 15,
    "weakMatchThreshold": 0.5,
    "skipFloor": 0.3
  },
  "mergeWindowConcurrency": 4,
  "mergeWindowRetryAttempts": 3,
  "mergeWindowRetryBaseMs": 100,
  "chunkTargetMs": 120000
}
